        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: '다음은 법무사 사무소의 전화 상담 녹음입니다. 내용을 빠짐없이 정확한 한국어로 전사해줘. 화자 구분 없이 대화 내용을 그대로 텍스트로 옮겨줘. 알아듣기 어려운 부분은 [청취불가]로 표시해줘.' }, { inlineData: { mimeType: $json.mimeType, data: $json.base64 } } ] } ] }) }}",
        "options": {
          "timeout": 120000
        }
      },
