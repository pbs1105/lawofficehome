      "notes": "업로드 파일 중 오디오 확장자만 통과시킴 (mp3/m4a/wav/aac/ogg/amr/wma/flac). 통화녹음 자동전사 트리거."
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  if (!item.binary || !item.binary.data) continue;\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const ext = (item.json.fileName || '').split('.').pop().toLowerCase();\n  const mimeMap = { mp3:'audio/mp3', m4a:'audio/aac', wav:'audio/wav', aac:'audio/aac', ogg:'audio/ogg', flac:'audio/flac', aiff:'audio/aiff' };\n  out.push({ json: {\n    fileName: item.json.fileName,\n    mimeType: mimeMap[ext] || (item.binary.data.mimeType) || 'audio/aac',\n    base64: buffer.toString('base64')\n  } });\n}\nreturn out;"
      },
      "id": "d4b2f100-0002-4d02-9ddd-000000000302",
