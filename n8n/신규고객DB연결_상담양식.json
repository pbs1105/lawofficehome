    {
      "parameters": {
        "jsCode": "const ctx = $('Resolve Customer Name Suffix').first().json;\nconst prefix = $now.setZone('Asia/Seoul').toFormat('yyMMdd');\nfunction pageTitle(p){ const props = (p.json && p.json.properties) || {}; for (const k of Object.keys(props)){ const pr = props[k]; if (pr && pr.type === 'title' && Array.isArray(pr.title)) return pr.title.map(t => t.plain_text).join(''); } return ''; }\n// 상담DB와 사건부DB는 같은 번호 공간(YYMMDD_NN)을 공유한다.\n// 두 DB의 오늘자 순번 최댓값 + 1 = 다음 순번 → 수임 확정 시 번호 그대로 사건부DB로 이관 가능.\nconst re = new RegExp('^' + prefix + '_(\\\\d{1,})');\nconst pages = [...$('Find Today Cases').all(), ...$input.all()].filter(i => i.json && i.json.id);\nlet maxSeq = 0;\nfor (const p of pages){ const m = pageTitle(p).trim().match(re); if (m){ const n = parseInt(m[1], 10); if (!isNaN(n) && n > maxSeq) maxSeq = n; } }\nconst seq = String(maxSeq + 1).padStart(2, '0');\nconst caseNo = `${prefix}_${seq}`;\nconst caseId = `${caseNo}-${ctx['최종고객명']}-${ctx['사건명']}`;\nreturn [{ json: { ...ctx, 사건번호: caseNo, 사건고유명: caseId } }];"
      },
