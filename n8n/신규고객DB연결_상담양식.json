      ],
      "notes": "파일명/mimeType(경로1)과 Gemini 응답(경로2)을 위치 기준으로 합침"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst items = $input.all();\nfor (const item of items) {\n  const d = item.json;\n  let transcript = '';\n  try {\n    transcript = d.candidates[0].content.parts[0].text || '';\n  } catch (e) {\n    transcript = '[전사 실패 - Gemini 응답을 확인해주세요]';\n  }\n  const origName = (d.fileName || 'recording').replace(/\\.[^.]+$/, '');\n  const nowKst = $now.setZone('Asia/Seoul').toFormat('yyyy-MM-dd HH:mm');\n  const header = [\n    '⚠️ AI 자동전사본 — 반드시 원음 대조 후 업무에 사용하세요.',\n    '원본파일: ' + (d.fileName || ''),\n    '전사일시: ' + nowKst,\n    '',\n    '──────────────────────────────',\n    ''\n  ].join('\\n');\n  const fullText = header + transcript;\n  const fileName = '상담내용_전사_' + origName + '.txt';\n  const buffer = Buffer.from(fullText, 'utf-8');\n  out.push({ json: { fileName }, binary: { data: await this.helpers.prepareBinaryData(buffer, fileName, 'text/plain') } });\n}\nreturn out;"
      },
