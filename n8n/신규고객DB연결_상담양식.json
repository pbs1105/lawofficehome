    {
      "parameters": {
        "jsCode": "const map = { '주식회사': '(주)', '유한회사': '(유)', '합명회사': '(명)', '합자회사': '(자)' };\nconst src = $('Normalize Input').first().json;\nconst ai = ($input.first().json.output) || {};\nlet baseName;\nif (src['고객유형'] === '법인') {\n  const prefix = map[src['회사유형']] || '';\n  baseName = `${prefix}${src['상호'] || ''}`.trim();\n} else {\n  baseName = (src['이름'] || '').trim();\n}\nreturn [{ json: {\n  고객유형: src['고객유형'] || '',\n  이름: src['이름'] || '',\n  회사유형: src['회사유형'] || '',\n  상호: src['상호'] || '',\n  휴대폰번호: src['휴대폰번호'] || '',\n  이메일: src['이메일'] || '',\n  상담유형: src['상담유형'] || '',\n  상담내용: src['상담내용'] || '',\n  사건명: ai['사건명'] || '',\n  기본고객명: baseName\n} }];"
      },
