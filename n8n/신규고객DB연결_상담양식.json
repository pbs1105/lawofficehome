    {
      "parameters": {
        "jsCode": "const ctx = $('Build Base Customer Name').first().json;\nconst base = ctx['기본고객명'] || '';\nfunction pageTitle(p){ const props = (p.json && p.json.properties) || {}; for (const k of Object.keys(props)){ const pr = props[k]; if (pr && pr.type === 'title' && Array.isArray(pr.title)) return pr.title.map(t => t.plain_text).join(''); } return ''; }\nconst esc = base.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst re = new RegExp('^' + esc + '\\\\d*$');\nconst pages = $input.all().filter(i => i.json && i.json.id);\nconst k = pages.filter(p => re.test(pageTitle(p))).length;\nconst finalName = k === 0 ? base : `${base}${k + 1}`;\nreturn [{ json: { ...ctx, 최종고객명: finalName, 동명수: k } }];"
      },
